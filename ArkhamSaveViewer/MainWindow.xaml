<Window x:Class="ArkhamSaveViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arkham City Save Viewer" Width="1250" Height="800" MinWidth="720" MinHeight="420">

    <Window.Resources>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,2" />
        </Style>
        <Style x:Key="MonoUnknown" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UnknownBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonoEdit" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: size to content and wrap, so nothing is clipped at any DPI or window width -->
        <StackPanel Grid.Row="0" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Grid.Column="0" Content="Open save..." Padding="12,4" Click="OpenButton_Click" />
                <TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button x:Name="ReloadButton" Grid.Column="2" Content="Reload" Padding="12,4" Click="ReloadButton_Click" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="AutoReload" Content="Auto reload" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                <CheckBox x:Name="UnknownOnly" Content="Unknown only" Margin="0,0,16,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                <TextBlock Text="Filter:" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBox x:Name="FilterBox" Width="170" Margin="0,0,16,0" ToolTip="Filter fields by name" TextChanged="FilterTextChanged" />
                <CheckBox x:Name="HideZeroFooter" Content="Hide zero bytes" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" Checked="HideZeroChanged" Unchecked="HideZeroChanged" />
                <Button x:Name="DumpButton" Content="Dump folder..." Padding="12,4" Margin="0,0,16,0" Click="DumpButton_Click" />
                <TextBlock Text="Theme:" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeBox" MinWidth="90" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="System" />
                </ComboBox>
            </WrapPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="8,0,8,0">
            <TabItem Header="All fields">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" MinHeight="60" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="FieldGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                              SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow"
                              SelectionChanged="FieldGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="240" ElementStyle="{StaticResource MonoUnknown}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="90" ElementStyle="{StaticResource Mono}" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Shown}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource Mono}" />
                            <DataGridTextColumn Header="Your label" Binding="{Binding Label, Mode=TwoWay}" Width="260" ElementStyle="{StaticResource Mono}" EditingElementStyle="{StaticResource MonoEdit}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
                    <TextBox x:Name="DetailBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6" />
                </Grid>
            </TabItem>

            <TabItem Header="Physical challenges">
                <DataGrid x:Name="ChallengeGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Current (float)" Binding="{Binding Current}" IsReadOnly="True" Width="130" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Best (float)" Binding="{Binding Best}" IsReadOnly="True" Width="130" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Beaten (uint)" Binding="{Binding Beaten}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Challenge name (yours)" Binding="{Binding Label, Mode=TwoWay}" Width="*" ElementStyle="{StaticResource Mono}" EditingElementStyle="{StaticResource MonoEdit}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Collectible strings">
                <DataGrid x:Name="CollectibleGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Name}" IsReadOnly="True" Width="600" ElementStyle="{StaticResource Mono}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Upgrade strings">
                <DataGrid x:Name="UpgradeGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Name}" IsReadOnly="True" Width="600" ElementStyle="{StaticResource Mono}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Flag strings">
                <DataGrid x:Name="FlagGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding Name}" IsReadOnly="True" Width="600" ElementStyle="{StaticResource Mono}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Footer bytes">
                <DataGrid x:Name="FooterGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" VerticalGridLinesBrush="{DynamicResource GridLineBrush}" LoadingRow="Grid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Copy" Binding="{Binding Copy}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Dec" Binding="{Binding Dec}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource Mono}" />
                        <DataGridTextColumn Header="Your label" Binding="{Binding Label, Mode=TwoWay}" Width="*" ElementStyle="{StaticResource Mono}" EditingElementStyle="{StaticResource MonoEdit}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="10,6">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
